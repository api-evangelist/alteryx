{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Credential",
  "type": "object",
  "description": "A stored credential for workflow execution",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique credential identifier"
    },
    "username": {
      "type": "string",
      "description": "Windows login username"
    }
  }
}